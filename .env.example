# Template for all environments. Copy and edit:
#   cp .env.example .env          # local dev (Mailhog, APP_DEBUG=true)
#   cp .env.example .env.prod      # production; fill secrets, then:
#   bash scripts/sync_env_github.sh push-prod
# CI/tests always use .env.example defaults (not .env.prod).

DATABASE_URL=postgresql+psycopg2://active:active@postgres:5432/active_defense
REDIS_URL=redis://redis:6379/0
# Run schema migrations + seed admin/demo accounts on app startup (set true in production deploy).
DB_BOOTSTRAP_ON_START=false
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@active-defense.local
SMTP_USER=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
# Production on Render: use brevo_api (HTTPS). Use smtp only when outbound SMTP is allowed.
EMAIL_BACKEND=brevo_api
BREVO_API_KEY=
ML_RISK_URL=http://localhost:8082
ML_API_KEY=
ML_FACET_MODE=false
SESSION_SECRET=change-me-in-production
SEED_ADMIN_PASSWORD=Admin123!
SEED_DEMO1_PASSWORD=Demo123!
SEED_DEMO2_PASSWORD=Demo123!
LINE_MFA_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
LINE_PUSH_API_URL=https://api.line.me/v2/bot/message/push
IP_BLOCK_TTL_SECONDS=300
MEDIUM_THRESHOLD=0.4
HIGH_THRESHOLD=0.7
BLOCK_THRESHOLD=0.9
BASELINE_DEVIATION_THRESHOLD=0.35
TRUST_PROXY_HEADERS=false
RATE_LIMIT_LOGIN_PER_MIN=30
RATE_LIMIT_MFA_SEND_PER_MIN=5
RATE_LIMIT_MFA_SEND_PER_CHALLENGE=3
RATE_LIMIT_MFA_VERIFY_PER_MIN=10
MFA_OTP_TTL_SECONDS=300
MFA_MAX_ATTEMPTS=3
APP_DEBUG=true
EXPOSE_DEBUG_OTP=false
MFA_AUTO_SEND=true
MFA_ALWAYS_REQUIRED=false
COOKIE_SECURE=false
BASE_URL=http://localhost:8000
NYCU_OAUTH_CLIENT_ID=
NYCU_OAUTH_CLIENT_SECRET=
NYCU_OAUTH_HTTP_TIMEOUT_SECONDS=60
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=http://localhost:8000/api/v1/auth/register/line/callback
LINE_OFFICIAL_ACCOUNT_URL=
FRONTEND_BASE_URL=http://localhost:8000
REGISTRATION_SESSION_TTL_SECONDS=900
RATE_LIMIT_REGISTER_PER_MIN=20
